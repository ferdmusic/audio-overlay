<Window x:Class="AudioMonitor.UI.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AudioMonitor.UI.Views"
        xmlns:p="clr-namespace:AudioMonitor.UI.Properties"
        Title="{x:Static p:Strings.SettingsWindowTitle}"
        Height="860" Width="520"
        MinHeight="700" MinWidth="480"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        WindowStartupLocation="CenterScreen"
        Icon="/image.ico"
        Loaded="Window_Loaded">

    <Window.Resources>
        <local:DeviceTypeGroupConverter x:Key="DeviceTypeGroupConverter"/>
    </Window.Resources>

    <!-- Main Container -->
    <Border Background="{DynamicResource SurfaceBrush}"
            CornerRadius="28">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="0" Color="#000000" Opacity="0.5"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0"
                    Background="{DynamicResource SurfaceContainerLowBrush}"
                    CornerRadius="28,28,0,0"
                    Padding="24,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{x:Static p:Strings.SettingsHeader}"
                                   FontFamily="{DynamicResource DisplayFont}"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource OnSurfaceBrush}"/>
                        <TextBlock Text="{x:Static p:Strings.SettingsSubtitle}"
                                   FontFamily="{DynamicResource BodyFont}"
                                   FontSize="14"
                                   Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Style="{DynamicResource M3IconButton}"
                            Click="MinimizeToTray_Click"
                            VerticalAlignment="Top">
                        <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                              Fill="{DynamicResource OnSurfaceVariantBrush}"
                              Width="20" Height="20"
                              Stretch="Uniform"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Scrollable Content -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24,16,24,24">

                    <!-- Audio Input Section -->
                    <Border Style="{DynamicResource M3Card}">
                        <StackPanel>
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Background="{DynamicResource PrimaryContainerBrush}"
                                        CornerRadius="16"
                                        Width="48" Height="48"
                                        Margin="0,0,16,0">
                                    <Path Data="M12,14c1.66,0,2.99-1.34,2.99-3L15,5c0-1.66-1.34-3-3-3S9,3.34,9,5v6C9,12.66,10.34,14,12,14z M17.3,11c0,3-2.54,5.1-5.3,5.1S6.7,14,6.7,11H5c0,3.41,2.72,6.23,6,6.72V21h2v-3.28c3.28-0.48,6-3.3,6-6.72H17.3z"
                                          Fill="{DynamicResource OnPrimaryContainerBrush}"
                                          Width="24" Height="24"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Static p:Strings.AudioInputDeviceSectionHeader}"
                                               FontFamily="{DynamicResource BodyFont}"
                                               FontSize="18"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource OnSurfaceBrush}"/>
                                    <TextBlock Text="{x:Static p:Strings.AudioInputDeviceDescription}"
                                               FontFamily="{DynamicResource BodyFont}"
                                               FontSize="13"
                                               Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- Live Level Display -->
                            <Border Background="{DynamicResource SurfaceContainerHighBrush}"
                                    CornerRadius="20"
                                    Padding="16"
                                    Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="CurrentLevelText"
                                                   Text="{x:Static p:Strings.CurrentLevelPlaceholder}"
                                                   FontFamily="{DynamicResource BodyFont}"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource OnSurfaceVariantBrush}"/>
                                        <TextBlock x:Name="PeakLevelText"
                                                   Grid.Column="1"
                                                   Text="{x:Static p:Strings.PeakLevelPlaceholder}"
                                                   FontFamily="{DynamicResource BodyFont}"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource OnSurfaceVariantBrush}"/>
                                    </Grid>
                                    <Border Background="{DynamicResource SurfaceContainerHighestBrush}"
                                            CornerRadius="10"
                                            Height="20"
                                            Padding="3">
                                        <Border x:Name="AudioLevelBar"
                                                Background="{DynamicResource StatusSafeBrush}"
                                                CornerRadius="7"
                                                HorizontalAlignment="Left"
                                                Width="0"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <ComboBox x:Name="AudioInputComboBox"
                                      Style="{DynamicResource M3ComboBox}"
                                      DisplayMemberPath="Name"
                                      SelectionChanged="AudioInputComboBox_SelectionChanged">
                                <ComboBox.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name, Converter={StaticResource DeviceTypeGroupConverter}}"
                                                           FontWeight="Medium"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource PrimaryBrush}"
                                                           Margin="16,12,16,8"/>
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                        <GroupStyle.ContainerStyle>
                                            <Style TargetType="{x:Type GroupItem}">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="{x:Type GroupItem}">
                                                            <StackPanel>
                                                                <ContentPresenter/>
                                                                <ItemsPresenter Margin="8,0,0,0"/>
                                                            </StackPanel>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </GroupStyle.ContainerStyle>
                                    </GroupStyle>
                                </ComboBox.GroupStyle>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <!-- Threshold Configuration Section -->
                    <Border Style="{DynamicResource M3Card}">
                        <StackPanel>
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Background="{DynamicResource SecondaryContainerBrush}"
                                        CornerRadius="16"
                                        Width="48" Height="48"
                                        Margin="0,0,16,0">
                                    <Path Data="M3.5,18.49l6-6.01l4,4L22,6.92l-1.41-1.41l-7.09,7.97l-4-4L2,16.99L3.5,18.49z"
                                          Fill="{DynamicResource OnSecondaryContainerBrush}"
                                          Width="24" Height="24"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Static p:Strings.ThresholdConfigSectionHeader}"
                                               FontFamily="{DynamicResource BodyFont}"
                                               FontSize="18"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource OnSurfaceBrush}"/>
                                    <TextBlock Text="{x:Static p:Strings.ThresholdConfigDescription}"
                                               FontFamily="{DynamicResource BodyFont}"
                                               FontSize="13"
                                               Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- Threshold Items -->
                            <StackPanel>
                                <!-- Safe Threshold -->
                                <Border Background="{DynamicResource SurfaceContainerHighBrush}"
                                        CornerRadius="16"
                                        Padding="16"
                                        Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Background="{DynamicResource StatusSafeBrush}"
                                                CornerRadius="12"
                                                Width="24" Height="24"
                                                Margin="0,0,12,0"/>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Static p:Strings.ThresholdSafeLabel}"
                                                       FontFamily="{DynamicResource BodyFont}"
                                                       FontSize="14"
                                                       FontWeight="Medium"
                                                       Foreground="{DynamicResource OnSurfaceBrush}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBox x:Name="ThresholdSafeTextBox"
                                                     Text="-12"
                                                     Style="{DynamicResource M3TextField}"
                                                     Width="80"
                                                     MinHeight="44"
                                                     TextAlignment="Center"
                                                     VerticalContentAlignment="Center"/>
                                            <TextBlock Text="{x:Static p:Strings.ThresholdUnitLabel}"
                                                       FontFamily="{DynamicResource BodyFont}"
                                                       FontSize="14"
                                                       Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Warning Threshold -->
                                <Border Background="{DynamicResource SurfaceContainerHighBrush}"
                                        CornerRadius="16"
                                        Padding="16"
                                        Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Background="{DynamicResource StatusWarningBrush}"
                                                CornerRadius="12"
                                                Width="24" Height="24"
                                                Margin="0,0,12,0"/>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Static p:Strings.ThresholdWarningLabel}"
                                                       FontFamily="{DynamicResource BodyFont}"
                                                       FontSize="14"
                                                       FontWeight="Medium"
                                                       Foreground="{DynamicResource OnSurfaceBrush}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBox x:Name="ThresholdWarningTextBox"
                                                     Text="-6"
                                                     Style="{DynamicResource M3TextField}"
                                                     Width="80"
                                                     MinHeight="44"
                                                     TextAlignment="Center"
                                                     VerticalContentAlignment="Center"/>
                                            <TextBlock Text="{x:Static p:Strings.ThresholdUnitLabel}"
                                                       FontFamily="{DynamicResource BodyFont}"
                                                       FontSize="14"
                                                       Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Critical Threshold -->
                                <Border Background="{DynamicResource SurfaceContainerHighBrush}"
                                        CornerRadius="16"
                                        Padding="16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Background="{DynamicResource StatusCriticalBrush}"
                                                CornerRadius="12"
                                                Width="24" Height="24"
                                                Margin="0,0,12,0"/>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Static p:Strings.ThresholdCriticalLabel}"
                                                       FontFamily="{DynamicResource BodyFont}"
                                                       FontSize="14"
                                                       FontWeight="Medium"
                                                       Foreground="{DynamicResource OnSurfaceBrush}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBox x:Name="ThresholdCriticalTextBox"
                                                     Text="-3"
                                                     Style="{DynamicResource M3TextField}"
                                                     Width="80"
                                                     MinHeight="44"
                                                     TextAlignment="Center"
                                                     VerticalContentAlignment="Center"/>
                                            <TextBlock Text="{x:Static p:Strings.ThresholdUnitLabel}"
                                                       FontFamily="{DynamicResource BodyFont}"
                                                       FontSize="14"
                                                       Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Visual Overlay Section -->
                    <Border Style="{DynamicResource M3Card}">
                        <StackPanel>
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Background="{DynamicResource TertiaryContainerBrush}"
                                        CornerRadius="16"
                                        Width="48" Height="48"
                                        Margin="0,0,16,0">
                                    <Path Data="M21,3H3C1.9,3,1,3.9,1,5v14c0,1.1,0.9,2,2,2h18c1.1,0,2-0.9,2-2V5C23,3.9,22.1,3,21,3z M21,19H3V5h18V19z"
                                          Fill="{DynamicResource OnTertiaryContainer}"
                                          Width="24" Height="24"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Static p:Strings.VisualOverlaySectionHeader}"
                                               FontFamily="{DynamicResource BodyFont}"
                                               FontSize="18"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource OnSurfaceBrush}"/>
                                    <TextBlock Text="{x:Static p:Strings.OverlayBehaviorInfo}"
                                               FontFamily="{DynamicResource BodyFont}"
                                               FontSize="13"
                                               Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- Position Selection -->
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="{x:Static p:Strings.OverlayPositionLabel}"
                                           FontFamily="{DynamicResource BodyFont}"
                                           FontSize="13"
                                           Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                           Margin="0,0,0,8"/>
                                <ComboBox x:Name="OverlayPositionComboBox"
                                          Style="{DynamicResource M3ComboBox}"/>
                            </StackPanel>

                            <!-- Thickness -->
                            <StackPanel>
                                <TextBlock Text="{x:Static p:Strings.OverlayThicknessLabel}"
                                           FontFamily="{DynamicResource BodyFont}"
                                           FontSize="13"
                                           Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                           Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="OverlayThicknessTextBox"
                                             Text="5"
                                             Style="{DynamicResource M3TextField}"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Static p:Strings.OverlayThicknessUnitLabel}"
                                               FontFamily="{DynamicResource BodyFont}"
                                               FontSize="14"
                                               Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                               VerticalAlignment="Center"
                                               Margin="12,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Acoustic Warning Section -->
                    <Border Style="{DynamicResource M3Card}">
                        <StackPanel>
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Background="{DynamicResource ErrorContainerBrush}"
                                        CornerRadius="16"
                                        Width="48" Height="48"
                                        Margin="0,0,16,0">
                                    <Path Data="M12,3v9.28c-0.47-0.17-0.97-0.28-1.5-0.28C8.01,12,6,14.01,6,16.5S8.01,21,10.5,21c2.31,0,4.2-1.75,4.45-4H15V6h4V3H12z"
                                          Fill="{DynamicResource OnErrorContainer}"
                                          Width="24" Height="24"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Static p:Strings.AcousticWarningSectionHeader}"
                                               FontFamily="{DynamicResource BodyFont}"
                                               FontSize="18"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource OnSurfaceBrush}"/>
                                    <TextBlock Text="{x:Static p:Strings.EnableAcousticWarningLabel}"
                                               FontFamily="{DynamicResource BodyFont}"
                                               FontSize="13"
                                               Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>

                                <CheckBox x:Name="AcousticWarningsCheckBox"
                                          Grid.Column="2"
                                          Style="{DynamicResource M3Switch}"
                                          IsChecked="True"
                                          VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Volume Slider -->
                            <Border Background="{DynamicResource SurfaceContainerHighBrush}"
                                    CornerRadius="16"
                                    Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{x:Static p:Strings.VolumeLabel}"
                                               FontFamily="{DynamicResource BodyFont}"
                                               FontSize="14"
                                               Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,16,0"/>

                                    <Slider x:Name="AcousticVolumeSlider"
                                            Grid.Column="1"
                                            Style="{DynamicResource M3Slider}"
                                            Minimum="0"
                                            Maximum="100"
                                            Value="75"
                                            ValueChanged="AcousticVolumeSlider_ValueChanged"
                                            VerticalAlignment="Center"/>

                                    <TextBlock x:Name="AcousticVolumeText"
                                               Grid.Column="2"
                                               Text="75%"
                                               FontFamily="{DynamicResource BodyFont}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryBrush}"
                                               VerticalAlignment="Center"
                                               MinWidth="45"
                                               TextAlignment="Right"
                                               Margin="16,0,0,0"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- System Settings Section -->
                    <Border Style="{DynamicResource M3Card}">
                        <StackPanel>
                            <!-- Autostart Toggle -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Background="{DynamicResource SurfaceContainerHighBrush}"
                                        CornerRadius="16"
                                        Width="48" Height="48"
                                        Margin="0,0,16,0">
                                    <Path Data="M12,4V1L8,5l4,4V6c3.31,0,6,2.69,6,6c0,1.01-0.25,1.97-0.7,2.8l1.46,1.46C19.54,15.03,20,13.57,20,12 C20,7.58,16.42,4,12,4z M12,18c-3.31,0-6-2.69-6-6c0-1.01,0.25-1.97,0.7-2.8L5.24,7.74C4.46,8.97,4,10.43,4,12c0,4.42,3.58,8,8,8 v3l4-4l-4-4V18z"
                                          Fill="{DynamicResource OnSurfaceVariantBrush}"
                                          Width="24" Height="24"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Static p:Strings.StartWithWindowsLabel}"
                                               FontFamily="{DynamicResource BodyFont}"
                                               FontSize="16"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource OnSurfaceBrush}"/>
                                    <TextBlock Text="{x:Static p:Strings.AutostartDescription}"
                                               FontFamily="{DynamicResource BodyFont}"
                                               FontSize="13"
                                               Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,0"/>
                                </StackPanel>

                                <CheckBox x:Name="AutostartCheckBox"
                                          Grid.Column="2"
                                          Style="{DynamicResource M3Switch}"
                                          IsChecked="False"
                                          VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Language Selection -->
                            <Border Background="{DynamicResource SurfaceContainerHighBrush}"
                                    CornerRadius="16"
                                    Padding="16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Path Data="M12.87,15.07l-2.54-2.51l0.03-0.03c1.74-1.94,2.98-4.17,3.71-6.53H17V4h-7V2H8v2H1v1.99h11.17C11.5,7.92,10.44,9.75,9,11.35 c-0.81-0.89-1.49-1.86-2.06-2.88H5.04c0.68,1.35,1.56,2.62,2.61,3.79l-4.48,4.4l1.42,1.42l4.41-4.41l2.75,2.75L12.87,15.07z M18.5,10h-2L12,22h2l1.12-3h4.75L21,22h2L18.5,10z M15.88,17l1.62-4.33L19.12,17H15.88z"
                                              Fill="{DynamicResource OnSurfaceVariantBrush}"
                                              Width="24" Height="24"
                                              Stretch="Uniform"
                                              VerticalAlignment="Center"
                                              Margin="0,0,12,0"/>

                                        <TextBlock Grid.Column="1"
                                                   Text="{x:Static p:Strings.LanguageSelectionLabel}"
                                                   FontFamily="{DynamicResource BodyFont}"
                                                   FontSize="14"
                                                   FontWeight="Medium"
                                                   Foreground="{DynamicResource OnSurfaceBrush}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>

                                    <ComboBox x:Name="LanguageComboBox"
                                              Style="{DynamicResource M3ComboBox}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- Footer with Action Buttons -->
            <Border Grid.Row="2"
                    Background="{DynamicResource SurfaceContainerLowBrush}"
                    CornerRadius="0,0,28,28"
                    Padding="24,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Content="{x:Static p:Strings.MinimizeToTrayButtonContent}"
                            Style="{DynamicResource M3OutlinedButton}"
                            Click="MinimizeToTray_Click"
                            HorizontalAlignment="Left"/>

                    <Button Grid.Column="1"
                            Content="{x:Static p:Strings.SaveSettingsButtonContent}"
                            Style="{DynamicResource M3TonalButton}"
                            Click="SaveSettings_Click"
                            Margin="0,0,12,0"/>

                    <Button Grid.Column="2"
                            Content="{x:Static p:Strings.StartMonitoringButtonContent}"
                            Style="{DynamicResource M3FilledButton}"
                            Click="StartMonitoring_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
