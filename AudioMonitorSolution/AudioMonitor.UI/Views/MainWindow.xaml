<Window x:Class="AudioMonitor.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        xmlns:local="clr-namespace:AudioMonitor.UI.Views"
        xmlns:p="clr-namespace:AudioMonitor.UI.Properties"
        Title="{x:Static p:Strings.MainWindowTitle}"
        Height="680" Width="480"
        MinHeight="600" MinWidth="420"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        Icon="/image.ico"
        Closing="Window_Closing"
        MouseDown="Window_MouseDown">

    <Window.Resources>
        <tb:TaskbarIcon x:Name="MyNotifyIcon" x:Key="MyNotifyIconResource"
                        IconSource="/image.ico"
                        ToolTipText="{x:Static p:Strings.MainWindowTitle}">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{x:Static p:Strings.TrayMenuShow}" Click="ShowMenuItem_Click"/>
                    <MenuItem Header="{x:Static p:Strings.TrayMenuSettings}" Click="SettingsMenuItem_Click"/>
                    <MenuItem Header="{x:Static p:Strings.TrayMenuExit}" Click="ExitMenuItem_Click"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <local:DeviceTypeGroupConverter x:Key="DeviceTypeGroupConverter"/>
    </Window.Resources>

    <!-- Main Container with M3 Surface -->
    <Border Background="{DynamicResource SurfaceBrush}"
            CornerRadius="28">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="0" Color="#000000" Opacity="0.5"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header with drag area -->
            <Border Grid.Row="0"
                    Background="{DynamicResource SurfaceContainerLowBrush}"
                    CornerRadius="28,28,0,0"
                    Padding="24,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="AudioMonitor"
                                   FontFamily="{DynamicResource DisplayFont}"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource OnSurfaceBrush}"/>
                        <TextBlock x:Name="StatusTextBlock"
                                   Text="{x:Static p:Strings.StatusMonitoring}"
                                   FontFamily="{DynamicResource BodyFont}"
                                   FontSize="14"
                                   Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Style="{DynamicResource M3IconButton}"
                                Click="SettingsMenuItem_Click"
                                ToolTip="{x:Static p:Strings.SettingsButtonContent}"
                                Margin="0,0,8,0">
                            <Path Data="M19.14,12.94c0.04-0.31,0.06-0.63,0.06-0.94c0-0.31-0.02-0.63-0.06-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61 l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41 h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87 C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.37,4.8,11.69,4.8,12s0.02,0.63,0.06,0.94l-2.03,1.58 c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54 c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96 c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.47-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6 s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z"
                                  Fill="{DynamicResource OnSurfaceVariantBrush}"
                                  Width="24" Height="24"
                                  Stretch="Uniform"/>
                        </Button>
                        <Button Style="{DynamicResource M3IconButton}"
                                Click="MinimizeToTray_Click"
                                ToolTip="{x:Static p:Strings.MinimizeToTrayButtonContent}">
                            <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                                  Fill="{DynamicResource OnSurfaceVariantBrush}"
                                  Width="20" Height="20"
                                  Stretch="Uniform"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24,16,24,24">

                    <!-- Audio Device Selection Card -->
                    <Border Style="{DynamicResource M3Card}">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Icon Container -->
                                <Border Background="{DynamicResource PrimaryContainerBrush}"
                                        CornerRadius="16"
                                        Width="48" Height="48"
                                        Margin="0,0,16,0">
                                    <Path Data="M12,14c1.66,0,2.99-1.34,2.99-3L15,5c0-1.66-1.34-3-3-3S9,3.34,9,5v6C9,12.66,10.34,14,12,14z M17.3,11c0,3-2.54,5.1-5.3,5.1S6.7,14,6.7,11H5c0,3.41,2.72,6.23,6,6.72V21h2v-3.28c3.28-0.48,6-3.3,6-6.72H17.3z"
                                          Fill="{DynamicResource OnPrimaryContainerBrush}"
                                          Width="24" Height="24"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Static p:Strings.AudioInputDeviceLabel}"
                                               FontFamily="{DynamicResource BodyFont}"
                                               FontSize="16"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource OnSurfaceBrush}"/>
                                    <TextBlock Text="{x:Static p:Strings.AudioInputDeviceDescription}"
                                               FontFamily="{DynamicResource BodyFont}"
                                               FontSize="12"
                                               Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>

                            <ComboBox x:Name="DeviceComboBox"
                                      Style="{DynamicResource M3ComboBox}"
                                      DisplayMemberPath="Name">
                                <ComboBox.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource DeviceTypeGroupConverter}}"
                                                           FontWeight="Medium"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource PrimaryBrush}"
                                                           Margin="16,12,16,8"/>
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </ComboBox.GroupStyle>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <!-- Live Level Indicator Card -->
                    <Border Style="{DynamicResource M3Card}">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Icon Container -->
                                <Border Background="{DynamicResource TertiaryContainerBrush}"
                                        CornerRadius="16"
                                        Width="48" Height="48"
                                        Margin="0,0,16,0">
                                    <Path Data="M3.5,18.49l6-6.01l4,4L22,6.92l-1.41-1.41l-7.09,7.97l-4-4L2,16.99L3.5,18.49z"
                                          Fill="{DynamicResource OnTertiaryContainer}"
                                          Width="24" Height="24"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Static p:Strings.LiveAudioLevelDisplayHeader}"
                                               FontFamily="{DynamicResource BodyFont}"
                                               FontSize="16"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource OnSurfaceBrush}"/>
                                    <TextBlock x:Name="CurrentLevelText"
                                               Text="{x:Static p:Strings.CurrentLevelPlaceholder}"
                                               FontFamily="{DynamicResource BodyFont}"
                                               FontSize="12"
                                               Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- Level Bar -->
                            <Border Background="{DynamicResource SurfaceContainerHighestBrush}"
                                    CornerRadius="12"
                                    Height="24"
                                    Padding="4">
                                <Border x:Name="AudioLevelBar"
                                        Background="{DynamicResource StatusSafeBrush}"
                                        CornerRadius="8"
                                        HorizontalAlignment="Left"
                                        Width="0"/>
                            </Border>

                            <!-- Peak Level -->
                            <TextBlock x:Name="PeakLevelText"
                                       Text="{x:Static p:Strings.PeakLevelPlaceholder}"
                                       FontFamily="{DynamicResource BodyFont}"
                                       FontSize="12"
                                       Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                       HorizontalAlignment="Right"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Quick Status Card -->
                    <Border Style="{DynamicResource M3Card}"
                            Background="{DynamicResource SurfaceContainerHighBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Overlay Status -->
                            <StackPanel HorizontalAlignment="Center" Margin="0,8">
                                <Border Background="{DynamicResource StatusSafeBrush}"
                                        CornerRadius="8"
                                        Width="16" Height="16"
                                        HorizontalAlignment="Center"
                                        Margin="0,0,0,8"/>
                                <TextBlock Text="{x:Static p:Strings.OverlayActiveLabel}"
                                           FontFamily="{DynamicResource BodyFont}"
                                           FontSize="12"
                                           Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- Warning Status -->
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center" Margin="0,8">
                                <Border x:Name="WarningIndicator"
                                        Background="{DynamicResource SurfaceContainerHighestBrush}"
                                        CornerRadius="8"
                                        Width="16" Height="16"
                                        HorizontalAlignment="Center"
                                        Margin="0,0,0,8"/>
                                <TextBlock Text="{x:Static p:Strings.AcousticWarningStatusLabel}"
                                           FontFamily="{DynamicResource BodyFont}"
                                           FontSize="12"
                                           Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Info Text -->
                    <TextBlock Text="{x:Static p:Strings.RunningMessage}"
                               FontFamily="{DynamicResource BodyFont}"
                               FontSize="14"
                               Foreground="{DynamicResource OnSurfaceVariantBrush}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="16,8,16,0"
                               Opacity="0.7"/>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
